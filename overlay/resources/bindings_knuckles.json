{
    "name": "OVR Dancers Tool Default Bindings (Valve Index)",
    "controller_type": "knuckles",
    "category": "steamvr_input",
    "bindings": {
        "/actions/ovrdancers": {
            "sources": [
                {
                    "path": "/user/hand/left/input/trigger",
                    "mode": "trigger",
                    "inputs": {
                        "pull": { "output": "/actions/ovrdancers/in/trigger_left" },
                        "click": { "output": "/actions/ovrdancers/in/trigger_click_l" }
                    }
                },
                {
                    "path": "/user/hand/right/input/trigger",
                    "mode": "trigger",
                    "inputs": {
                        "pull": { "output": "/actions/ovrdancers/in/trigger_right" },
                        "click": { "output": "/actions/ovrdancers/in/trigger_click_r" }
                    }
                },
                {
                    "path": "/user/hand/left/input/squeeze",
                    "mode": "force_sensor",
                    "inputs": {
                        "force": { "output": "/actions/ovrdancers/in/grip_left" },
                        "click": { "output": "/actions/ovrdancers/in/grip_click_l" }
                    }
                },
                {
                    "path": "/user/hand/right/input/squeeze",
                    "mode": "force_sensor",
                    "inputs": {
                        "force": { "output": "/actions/ovrdancers/in/grip_right" },
                        "click": { "output": "/actions/ovrdancers/in/grip_click_r" }
                    }
                },
                {
                    "path": "/user/hand/left/input/thumbstick",
                    "mode": "joystick",
                    "inputs": {
                        "position": { "output": "/actions/ovrdancers/in/thumbstick_left" },
                        "click": { "output": "/actions/ovrdancers/in/thumbstick_click_l" }
                    }
                },
                {
                    "path": "/user/hand/right/input/thumbstick",
                    "mode": "joystick",
                    "inputs": {
                        "position": { "output": "/actions/ovrdancers/in/thumbstick_right" },
                        "click": { "output": "/actions/ovrdancers/in/thumbstick_click_r" }
                    }
                },
                {
                    "path": "/user/hand/left/input/a",
                    "mode": "button",
                    "inputs": {
                        "click": { "output": "/actions/ovrdancers/in/x_click" }
                    }
                },
                {
                    "path": "/user/hand/left/input/b",
                    "mode": "button",
                    "inputs": {
                        "click": { "output": "/actions/ovrdancers/in/y_click" }
                    }
                },
                {
                    "path": "/user/hand/right/input/a",
                    "mode": "button",
                    "inputs": {
                        "click": { "output": "/actions/ovrdancers/in/a_click" }
                    }
                },
                {
                    "path": "/user/hand/right/input/b",
                    "mode": "button",
                    "inputs": {
                        "click": { "output": "/actions/ovrdancers/in/toggle_hands" }
                    }
                }
            ]
        }
    },
    "description": "Default OVR Dancers Tool bindings for Valve Index Knuckles"
}
