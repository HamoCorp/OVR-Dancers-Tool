{
    "name": "OVR Dancers Tool Default Bindings (Vive Controller)",
    "controller_type": "vive_controller",
    "category": "steamvr_input",
    "bindings": {
        "/actions/ovrdancers": {
            "sources": [
                {
                    "path": "/user/hand/left/input/trigger",
                    "mode": "trigger",
                    "inputs": {
                        "pull": { "output": "/actions/ovrdancers/in/trigger_left" },
                        "click": { "output": "/actions/ovrdancers/in/trigger_click_l" }
                    }
                },
                {
                    "path": "/user/hand/right/input/trigger",
                    "mode": "trigger",
                    "inputs": {
                        "pull": { "output": "/actions/ovrdancers/in/trigger_right" },
                        "click": { "output": "/actions/ovrdancers/in/trigger_click_r" }
                    }
                },
                {
                    "path": "/user/hand/left/input/grip",
                    "mode": "button",
                    "inputs": {
                        "click": { "output": "/actions/ovrdancers/in/grip_click_l" }
                    }
                },
                {
                    "path": "/user/hand/right/input/grip",
                    "mode": "button",
                    "inputs": {
                        "click": { "output": "/actions/ovrdancers/in/grip_click_r" }
                    }
                },
                {
                    "path": "/user/hand/left/input/trackpad",
                    "mode": "trackpad",
                    "inputs": {
                        "position": { "output": "/actions/ovrdancers/in/thumbstick_left" },
                        "click": { "output": "/actions/ovrdancers/in/thumbstick_click_l" }
                    }
                },
                {
                    "path": "/user/hand/right/input/trackpad",
                    "mode": "trackpad",
                    "inputs": {
                        "position": { "output": "/actions/ovrdancers/in/thumbstick_right" },
                        "click": { "output": "/actions/ovrdancers/in/thumbstick_click_r" }
                    }
                },
                {
                    "path": "/user/hand/right/input/application_menu",
                    "mode": "button",
                    "inputs": {
                        "click": { "output": "/actions/ovrdancers/in/toggle_hands" }
                    }
                }
            ]
        }
    },
    "description": "Default OVR Dancers Tool bindings for Vive Controller"
}
